# Elenko environment (copy to .env in the application root, or let install-windows.ps1 create it)

PORT=3000
COUCHDB_URL=http://admin:admin@127.0.0.1:5984
COUCHDB_DB=elenko
ELENKO_CONFIG_DB=elenko_config

# Start page icons (pixels, long edge after upload): folders 512, database circles 256
# GROUP_START_ICON_MAX_EDGE=512
# PROFILE_START_ICON_MAX_EDGE=256

# Optional: override default paths (defaults are relative to the app directory)
# IO_DIR=
# COUCHDB_BOOTSTRAP_FILE=
# FLOW_LOG_FILE=logs/elenko.log

# Session cookie signing (required, min 32 chars; install script generates a random value on first install)
SESSION_SECRET=

# Behind Caddy/Cloudflare: trust one X-Forwarded-* hop (default 1). Use 0 for plain local HTTP without a proxy.
# TRUST_PROXY=1

# Session cookie: secure=auto sets Secure on HTTPS when trust proxy is enabled. sameSite defaults to lax.
# ELENKO_SESSION_COOKIE_SECURE=auto
# ELENKO_SESSION_COOKIE_SAMESITE=lax

# Local dev only — allows missing/weak SESSION_SECRET (never use on internet-facing hosts).
# ELENKO_ALLOW_INSECURE_SESSION=1

# CSRF protection for logged-in POST/PUT/PATCH/DELETE (session synchronizer token). 0 = off (not recommended).
# ELENKO_CSRF_PROTECTION=1

# HTTP JSON body size: default for most routes; larger cap only on import paths (config/CSV import, federation inbox, etc.).
# HTTP_BODY_LIMIT_DEFAULT=512kb
# HTTP_BODY_LIMIT_IMPORT=15mb

# Application user passwords (create user / change password): min length, character classes, local common-password denylist.
# USER_PASSWORD_MIN_LENGTH=10
# USER_PASSWORD_MIN_CLASSES=2
# USER_PASSWORD_CHECK_COMMON=1
# USER_PASSWORD_DENYLIST_FILE=data/common-passwords.txt

# Optional: log out after N minutes without HTTP requests (0 = off). Overridable in Application properties.
# SESSION_INACTIVITY_MINUTES=60

# After a failed sign-in, wait this many seconds before another attempt (per client IP). Default: 10. 0 = off.
# LOGIN_FAILURE_COOLDOWN_SECONDS=10

# Max uploaded ELNK key file size in bytes (default: 10× current v1 size, 440). Raises with ELNK_KEYFILE_FORMAT_MAX_BYTES in server.js.
# ELNK_KEYFILE_UPLOAD_MAX_BYTES=440

# Require key file at login for every user (1/on = yes, default). Overridable in Application properties.
# ENFORCE_KEY_FILES_FOR_ALL_USERS=1

# Flow log verbosity: minimal | normal | verbose
# FLOW_LOG_LEVEL=normal

# Pause between entry flow runs when a timer bulk-runs all documents in a profile (milliseconds). Default: 5000
# TIMER_BULK_RUN_DELAY_MS=5000

# Optional User-Agent for outbound REST/RSS API calls (helps some feeds; HN/Cloudflare may still block datacenter/Docker IPs)
# ELENKO_HTTP_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36

# Federation v1: allow http:// hub URLs for local testing (default: HTTPS only)
# ELENKO_FEDERATION_ALLOW_HTTP=1

# Public HTTPS origin of this Elenko instance (hub), used when exporting peer config for home
# ELENKO_PUBLIC_BASE_URL=https://elenko.example.com
