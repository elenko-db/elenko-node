# Elenko environment (copy to .env in the application root, or let install-windows.ps1 create it)

PORT=3000
COUCHDB_URL=http://admin:admin@127.0.0.1:5984
COUCHDB_DB=elenko
ELENKO_CONFIG_DB=elenko_config

# Start page icons (pixels, long edge after upload): folders 512, database circles 256
# GROUP_START_ICON_MAX_EDGE=512
# PROFILE_START_ICON_MAX_EDGE=256

# Optional: override default paths (defaults are relative to the app directory)
# IO_DIR=
# COUCHDB_BOOTSTRAP_FILE=
# FLOW_LOG_FILE=logs/elenko.log

# Session cookie signing (install script generates a random value on first install)
SESSION_SECRET=

# Flow log verbosity: minimal | normal | verbose
# FLOW_LOG_LEVEL=normal

# Pause between entry flow runs when a timer bulk-runs all documents in a profile (milliseconds). Default: 5000
# TIMER_BULK_RUN_DELAY_MS=5000
